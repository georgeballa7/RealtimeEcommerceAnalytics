            <column-instance column='[active_buyers]' derivation='Sum' name='[sum:active_buyers:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.ecommerce (copy)].[none:report_section:nk]'>
            <groupfilter function='member' level='[none:report_section:nk]' member='&quot;buyer_kpis&quot;' />
          </filter>
          <slices>
            <column>[federated.ecommerce (copy)].[none:report_section:nk]</column>
          </slices>

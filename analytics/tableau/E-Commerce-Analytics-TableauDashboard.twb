      <style>
        <style-rule element='mark'>
          <encoding attr='color' field='[none:series:nk]' type='palette'>
            <map to='#4e79a7'>
              <bucket>&quot;Actual&quot;</bucket>
            </map>
            <map to='#59a14f'>
              <bucket>&quot;Predicted&quot;</bucket>
            </map>
            <map to='#76b7b2'>
              <bucket>&quot;Observed&quot;</bucket>
            </map>
            <map to='#e15759'>
              <bucket>&quot;Weekday mean&quot;</bucket>
            </map>
            <map to='#f28e2b'>
              <bucket>&quot;Regression&quot;</bucket>
            </map>
          </encoding>
        </style-rule>
      </style>
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;United States&quot;' />
      </semantic-values>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Focal SKU' datatype='string' name='[Focal SKU]' param-domain-type='any' role='measure' type='nominal' value='&quot;&quot;'>
          <calculation class='tableau' formula='&quot;&quot;' />
        </column>
        <column caption='Minimum shared orders' datatype='integer' name='[Minimum shared orders]' param-domain-type='any' role='measure' type='quantitative' value='5'>
          <calculation class='tableau' formula='5' />
        </column>
        <column caption='Outreach capacity' datatype='integer' name='[Outreach capacity]' param-domain-type='any' role='measure' type='quantitative' value='100'>
          <calculation class='tableau' formula='100' />
        </column>
        <column caption='Reporting month' datatype='integer' name='[Reporting month]' param-domain-type='any' role='measure' type='quantitative' value='202610'>
          <calculation class='tableau' formula='202610' />
        </column>
        <column caption='Risk band' datatype='string' name='[Risk band]' param-domain-type='any' role='measure' type='nominal' value='&quot;Very high&quot;'>
          <calculation class='tableau' formula='&quot;Very high&quot;' />
        </column>
      </datasource-dependencies>
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name='Active buyers'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#17354c' fontname='Tableau Book' fontsize='12'>Active buyers</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Redshift_Ecommerce_Analytics' name='federated.ecommerce (copy)' />
          </datasources>

            <connection authentication='auth-user-pass' class='redshift' dbname='analytics' odbc-connect-string-extras='' one-time-sql='' port='15439' schema='analytics_marts' server='localhost' single-node='' sslmode='require' username='IAMR:ecommerce-tableau-bi-readonly-demo' />
          </named-connection>
        </named-connections>
        <relation connection='redshift.warehouse (copy)' name='ecommerce_analytics' type='text'><![CDATA[SELECT 'monthly'::varchar(48) AS report_section, q."period"::varchar(1024) AS "period", q."sales"::double precision AS "sales", q."orders"::double precision AS "orders", q."aov"::double precision AS "aov", NULL::double precision AS "growth", NULL::double precision AS "volume_effect", NULL::double precision AS "basket_effect", NULL::varchar(1024) AS "stage", NULL::double precision AS "amount", NULL::varchar(1024) AS "day_of_month", NULL::varchar(1024) AS "source_system", NULL::varchar(1024) AS "series", NULL::varchar(1024) AS "model", NULL::double precision AS "mae", NULL::varchar(1024) AS "event_day", NULL::double precision AS "error_orders", NULL::varchar(1024) AS "sku_rank", NULL::double precision AS "merchandise", NULL::bigint AS "units", NULL::double precision AS "unit_value", NULL::double precision AS "cumulative_share", NULL::bigint AS "selling_skus", NULL::double precision AS "top_ten_share", NULL::double precision AS "multi_share", NULL::double precision AS "mean_skus", NULL::varchar(1024) AS "pair", NULL::bigint AS "shared", NULL::double precision AS "support", NULL::double precision AS "confidence_ab", NULL::double precision AS "confidence_ba", NULL::double precision AS "lift", NULL::varchar(1024) AS "segment", NULL::bigint AS "buyers", NULL::bigint AS "active_buyers", NULL::bigint AS "new_buyers", NULL::bigint AS "returning_buyers", NULL::double precision AS "orders_per_buyer", NULL::varchar(1024) AS "cohort", NULL::varchar(1024) AS "month_index", NULL::double precision AS "retention", NULL::varchar(1024) AS "horizon", NULL::double precision AS "repeat_rate", NULL::varchar(1024) AS "event_type", NULL::bigint AS "affected_orders", NULL::double precision AS "rate", NULL::varchar(1024) AS "order_key", NULL::varchar(1024) AS "variant", NULL::double precision AS "subtotal", NULL::varchar(1024) AS "buyer", NULL::varchar(1024) AS "score_date", NULL::double precision AS "spend", NULL::double precision AS "risk", NULL::bigint AS "recency_days", NULL::bigint AS "order_count_90d", NULL::varchar(1024) AS "risk_segment", NULL::bigint AS "customers", NULL::varchar(1024) AS "decile", NULL::double precision AS "probability", NULL::double precision AS "roc_auc", NULL::double precision AS "model_precision", NULL::double precision AS "model_recall", NULL::bigint AS "fact_daily", NULL::bigint AS "daily_bi", NULL::double precision AS "amount_gap", NULL::varchar(1024) AS "layer", NULL::varchar(1024) AS "latest", NULL::varchar(1024) AS "week_start", NULL::varchar(1024) AS "weekday", NULL::varchar(1024) AS "sku", NULL::varchar(1024) AS "metric", NULL::double precision AS "typical", NULL::bigint AS "cancelled_units" FROM (
with s as (select sales_month, sum(orders) as orders,sum(net_sales_gbp) sales from analytics_ml.tableau_lb_v_monthly_sales group by 1), a as (select *,sales/nullif(orders,0) aov,lag(orders) over(order by sales_month) po,lag(sales) over(order by sales_month) ps,lag(sales/nullif(orders,0)) over(order by sales_month) pa from s) select to_char(sales_month,'YYYY-MM') period,sales,orders,aov from a where to_date(cast(<[Parameters].[Reporting month]> as varchar)||'01','YYYYMMDD') >= sales_month
) q
UNION ALL
SELECT 'headline'::varchar(48) AS report_section, NULL, q."sales"::double precision, q."orders"::double precision, q."aov"::double precision, q."growth"::double precision, q."volume_effect"::double precision, q."basket_effect"::double precision, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL FROM (
with s as (select sales_month, sum(orders) as orders,sum(net_sales_gbp) sales from analytics_ml.tableau_lb_v_monthly_sales group by 1), a as (select *,sales/nullif(orders,0) aov,lag(orders) over(order by sales_month) po,lag(sales) over(order by sales_month) ps,lag(sales/nullif(orders,0)) over(order by sales_month) pa from s) select sales,orders,aov,sales/nullif(ps,0)-1 growth,(orders-po)*pa volume_effect,orders*(aov-pa) basket_effect from a where sales_month=to_date(cast(<[Parameters].[Reporting month]> as varchar)||'01','YYYYMMDD')
) q
UNION ALL
SELECT 'bridge'::varchar(48) AS report_section, NULL, NULL, NULL, NULL, NULL, NULL, NULL, q."stage"::varchar(1024), q."amount"::double precision, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL FROM (
with s as (select sales_month, sum(orders) as orders,sum(net_sales_gbp) sales from analytics_ml.tableau_lb_v_monthly_sales group by 1), a as (select *,sales/nullif(orders,0) aov,lag(orders) over(order by sales_month) po,lag(sales) over(order by sales_month) ps,lag(sales/nullif(orders,0)) over(order by sales_month) pa from s) ,sel as (select * from a where sales_month=to_date(cast(<[Parameters].[Reporting month]> as varchar)||'01','YYYYMMDD')) select '1  Opening sales' stage,ps amount from sel union all select '2  Order volume',(orders-po)*pa from sel union all select '3  Basket value',orders*(aov-pa) from sel union all select '4  Closing sales',sales from sel
) q
UNION ALL
SELECT 'daily'::varchar(48) AS report_section, NULL, NULL, q."orders"::double precision, q."aov"::double precision, NULL, NULL, NULL, NULL, NULL, q."day_of_month"::varchar(1024), q."source_system"::varchar(1024), NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL FROM (
select to_char(order_date,'DD') day_of_month,source_system,sum(orders) orders,sum(current_gbp)/nullif(sum(orders),0) aov from analytics_marts.mart_daily_sales where date_trunc('month',order_date)=to_date(cast(<[Parameters].[Reporting month]> as varchar)||'01','YYYYMMDD') group by 1,2
) q
UNION ALL
SELECT 'demand'::varchar(48) AS report_section, NULL, NULL, q."orders"::double precision, NULL, NULL, NULL, NULL, NULL, NULL, q."day_of_month"::varchar(1024), NULL, q."series"::varchar(1024), NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL FROM (
with days as (select distinct date_key::date d from analytics_marts.dim_date where date_key::date between '2026-01-01' and '2026-10-31'), counts as (select order_timestamp_utc::date d,count(*) n from analytics_marts.fct_orders where source_system='synthetic_2026' group by 1), obs as (select d.d,coalesce(n,0)::float y,datediff(day,'2026-01-01',d.d)::float x,extract(dow from d.d) w from days d left join counts c on c.d=d.d), means as (select w,avg(x) mx,avg(y) my from obs where '2026-10-01' > d group by 1), fit as (select sum((x-mx)*(y-my))/nullif(sum((x-mx)*(x-mx)),0) slope from obs join means using(w) where '2026-10-01' > d), pred as (select d,y,my baseline,my+slope*(x-mx) prediction from obs join means using(w) cross join fit where d>='2026-10-01') select to_char(d,'DD') day_of_month,'Actual' series,y orders from pred union all select to_char(d,'DD'),'Regression',prediction from pred union all select to_char(d,'DD'),'Weekday mean',baseline from pred
) q
UNION ALL
SELECT 'errors'::varchar(48) AS report_section, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, q."model"::varchar(1024), q."mae"::double precision, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL FROM (
with days as (select distinct date_key::date d from analytics_marts.dim_date where date_key::date between '2026-01-01' and '2026-10-31'), counts as (select order_timestamp_utc::date d,count(*) n from analytics_marts.fct_orders where source_system='synthetic_2026' group by 1), obs as (select d.d,coalesce(n,0)::float y,datediff(day,'2026-01-01',d.d)::float x,extract(dow from d.d) w from days d left join counts c on c.d=d.d), means as (select w,avg(x) mx,avg(y) my from obs where '2026-10-01' > d group by 1), fit as (select sum((x-mx)*(y-my))/nullif(sum((x-mx)*(x-mx)),0) slope from obs join means using(w) where '2026-10-01' > d), pred as (select d,y,my baseline,my+slope*(x-mx) prediction from obs join means using(w) cross join fit where d>='2026-10-01') select 'Regression' model,avg(abs(y-prediction)) mae from pred union all select 'Weekday mean',avg(abs(y-baseline)) from pred
) q
UNION ALL
SELECT 'misses'::varchar(48) AS report_section, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, q."event_day"::varchar(1024), q."error_orders"::double precision, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL FROM (
with days as (select distinct date_key::date d from analytics_marts.dim_date where date_key::date between '2026-01-01' and '2026-10-31'), counts as (select order_timestamp_utc::date d,count(*) n from analytics_marts.fct_orders where source_system='synthetic_2026' group by 1), obs as (select d.d,coalesce(n,0)::float y,datediff(day,'2026-01-01',d.d)::float x,extract(dow from d.d) w from days d left join counts c on c.d=d.d), means as (select w,avg(x) mx,avg(y) my from obs where '2026-10-01' > d group by 1), fit as (select sum((x-mx)*(y-my))/nullif(sum((x-mx)*(x-mx)),0) slope from obs join means using(w) where '2026-10-01' > d), pred as (select d,y,my baseline,my+slope*(x-mx) prediction from obs join means using(w) cross join fit where d>='2026-10-01') select to_char(d,'YYYY-MM-DD') as event_day,y-prediction error_orders from pred order by abs(y-prediction) desc limit 5
) q
UNION ALL
SELECT 'portfolio'::varchar(48) AS report_section, NULL, NULL, q."orders"::double precision, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, q."sku_rank"::varchar(1024), q."merchandise"::double precision, q."units"::bigint, q."unit_value"::double precision, q."cumulative_share"::double precision, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL FROM (
with sku_totals as (select source_system,sku,sum(gross_line_gbp) merchandise,sum(quantity) units,count(distinct order_key) orders from analytics_marts.fct_order_lines where sku is not null and date_trunc('month',order_date_key::date)=to_date(cast(<[Parameters].[Reporting month]> as varchar)||'01','YYYYMMDD') group by 1,2), ranked as (select *,row_number() over(order by merchandise desc,source_system,sku) pos,sum(merchandise) over() total,sum(merchandise) over(order by merchandise desc,source_system,sku rows unbounded preceding) cum from sku_totals) select lpad(pos::varchar,4,'0')||'  '||sku sku_rank,merchandise,units,orders,merchandise/nullif(units,0) unit_value,cum/nullif(total,0) cumulative_share from ranked where 20 >= pos
) q
UNION ALL
SELECT 'concentration'::varchar(48) AS report_section, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, q."merchandise"::double precision, q."units"::bigint, NULL, NULL, q."selling_skus"::bigint, q."top_ten_share"::double precision, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL FROM (
with sku_totals as (select source_system,sku,sum(gross_line_gbp) merchandise,sum(quantity) units,count(distinct order_key) orders from analytics_marts.fct_order_lines where sku is not null and date_trunc('month',order_date_key::date)=to_date(cast(<[Parameters].[Reporting month]> as varchar)||'01','YYYYMMDD') group by 1,2), ranked as (select *,row_number() over(order by merchandise desc,source_system,sku) pos,sum(merchandise) over() total,sum(merchandise) over(order by merchandise desc,source_system,sku rows unbounded preceding) cum from sku_totals) select max(total) merchandise,sum(units) units,count(*) selling_skus,sum(case when 10 >= pos then merchandise else 0 end)/nullif(max(total),0) top_ten_share from ranked
) q
UNION ALL
SELECT 'basket_size'::varchar(48) AS report_section, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, q."source_system"::varchar(1024), NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, q."multi_share"::double precision, q."mean_skus"::double precision, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL FROM (
with items as (select source_system,order_key,sku,sum(quantity) units from analytics_marts.fct_order_lines where date_trunc('month',order_date_key::date)=to_date(cast(<[Parameters].[Reporting month]> as varchar)||'01','YYYYMMDD') and sku is not null group by 1,2,3), baskets as (select source_system,order_key,count(*) skus,sum(units) units from items group by 1,2) select source_system,avg(case when skus>1 then 1.0 else 0.0 end) multi_share,avg(skus::float) mean_skus from baskets group by 1
) q
UNION ALL
SELECT 'pairs'::varchar(48) AS report_section, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, q."source_system"::varchar(1024), NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, q."pair"::varchar(1024), q."shared"::bigint, q."support"::double precision, q."confidence_ab"::double precision, q."confidence_ba"::double precision, q."lift"::double precision, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL FROM (
with items as (select source_system,order_key,sku,sum(quantity) units from analytics_marts.fct_order_lines where date_trunc('month',order_date_key::date)=to_date(cast(<[Parameters].[Reporting month]> as varchar)||'01','YYYYMMDD') and sku is not null group by 1,2,3), baskets as (select source_system,order_key,count(*) skus,sum(units) units from items group by 1,2), freq as (select source_system,sku,count(*) n from items group by 1,2), totals as (select source_system,count(*) n from baskets group by 1), pairs as (select a.source_system,a.sku a,b.sku b,count(*) shared from items a join items b on a.source_system=b.source_system and a.order_key=b.order_key and b.sku > a.sku where (<[Parameters].[Focal SKU]>='' or a.sku=<[Parameters].[Focal SKU]> or b.sku=<[Parameters].[Focal SKU]>) group by 1,2,3 having count(*)>=<[Parameters].[Minimum shared orders]>), scores as (select p.*,shared::float/t.n support,shared::float/fa.n confidence_ab,shared::float/fb.n confidence_ba,shared::float*t.n/(fa.n::float*fb.n) lift from pairs p join freq fa on fa.source_system=p.source_system and fa.sku=p.a join freq fb on fb.source_system=p.source_system and fb.sku=p.b join totals t on t.source_system=p.source_system), ranked as (select *,row_number() over(order by shared desc,lift desc,source_system,a,b) pos from scores) select lpad(pos::varchar,2,'0')||'  '||a||' / '||b pair,source_system,shared,support,confidence_ab,confidence_ba,lift from ranked where 20 >= pos
) q
UNION ALL
SELECT 'customer_mix'::varchar(48) AS report_section, q."period"::varchar(1024), q."sales"::double precision, q."orders"::double precision, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, q."segment"::varchar(1024), q."buyers"::bigint, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL FROM (
with buyer as (select date_trunc('month',o.order_timestamp_utc) mth,o.customer_key,case when date_trunc('month',c.first_order_at)=date_trunc('month',o.order_timestamp_utc) then 'New' else 'Returning' end segment,count(*) orders,sum(o.current_gbp) sales from analytics_marts.fct_orders o join analytics_marts.dim_customers c on c.customer_key=o.customer_key where dateadd(month,1,to_date(cast(<[Parameters].[Reporting month]> as varchar)||'01','YYYYMMDD')) > o.order_timestamp_utc group by 1,2,3) select to_char(mth,'YYYY-MM') period,segment,count(*) buyers,sum(orders) orders,sum(sales) sales from buyer group by 1,2
) q
UNION ALL
SELECT 'buyer_kpis'::varchar(48) AS report_section, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, q."active_buyers"::bigint, q."new_buyers"::bigint, q."returning_buyers"::bigint, q."orders_per_buyer"::double precision, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL FROM (

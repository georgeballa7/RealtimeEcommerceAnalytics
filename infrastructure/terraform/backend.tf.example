# Activate only AFTER infrastructure/bootstrap has provisioned the bucket.
# Copy this file to backend.tf, replace the bucket name, and reinitialize Terraform.
terraform {
  backend "s3" {
    bucket       = "REPLACE_WITH_BOOTSTRAP_STATE_BUCKET"
    key          = "ecommerce/demo/terraform.tfstate"
    region       = "eu-central-1"
    profile      = "ecommerce-admin"
    encrypt      = true
    use_lockfile = true
  }
}

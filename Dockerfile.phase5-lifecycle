# Build from repository root after overlay is reviewed and merged into checkout.
# Does not create Shopify orders automatically at container startup.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /opt/app
COPY pyproject.toml ./
COPY src/ ./src/
COPY scripts/run_phase5_lifecycle.py ./scripts/
COPY config/phase4-simulation-policy.json ./config/phase4-simulation-policy.json
COPY config/phase5-synthetic-refund-policy.json ./config/phase5-synthetic-refund-policy.json
RUN pip install --no-cache-dir ".[shopify,aws]" && useradd --system --uid 10001 ecommerce
USER ecommerce
ENTRYPOINT ["python", "scripts/run_phase5_lifecycle.py"]

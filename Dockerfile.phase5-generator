FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 AWS_DEFAULT_REGION=eu-central-1
WORKDIR /opt/app
COPY pyproject.toml ./
COPY src/ ./src/
COPY scripts/generate_shopify_live_orders.py ./scripts/generate_shopify_live_orders.py
COPY config/catalog/phase5-gbp-sku-prices-v1.json ./config/catalog/phase5-gbp-sku-prices-v1.json
COPY config/phase4-simulation-policy.json ./config/phase4-simulation-policy.json
RUN python -c "from pathlib import Path; import hashlib; p=Path('config/catalog/phase5-gbp-sku-prices-v1.json'); b=p.read_bytes().replace(b'\r\n',b'\n'); assert hashlib.sha256(b).hexdigest()=='7850c9f5faaea304b0d42c468a10179c8d44905f5ca82b7767e7497152fb2c06', 'Manifest hash mismatch'; p.write_bytes(b)" \
    && pip install --no-cache-dir ".[shopify,aws]" \
    && useradd --system --uid 10001 ecommerce
USER ecommerce
ENTRYPOINT ["python", "scripts/generate_shopify_live_orders.py"]

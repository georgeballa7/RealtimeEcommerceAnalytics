FROM public.ecr.aws/lambda/python:3.12
COPY pyproject.toml ${LAMBDA_TASK_ROOT}/
COPY src/ ${LAMBDA_TASK_ROOT}/src/
RUN pip install --no-cache-dir 'fastapi>=0.115' 'mangum>=0.19' 'boto3>=1.35' 'psycopg[binary]>=3.2' && chmod -R a+rX ${LAMBDA_TASK_ROOT}/src
ENV PYTHONPATH=${LAMBDA_TASK_ROOT}/src PYTHONDONTWRITEBYTECODE=1
CMD ["ecommerce.interfaces.http.shopify_webhooks_lambda.handler"]

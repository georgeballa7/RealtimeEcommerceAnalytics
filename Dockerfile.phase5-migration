FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
    && curl --fail --silent --show-error \
       https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem \
       -o /etc/ssl/certs/rds-global-bundle.pem \
    && test -s /etc/ssl/certs/rds-global-bundle.pem \
    && apt-get purge -y curl && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/app
COPY scripts/apply_phase5_price_migration.py /opt/app/apply_phase5_price_migration.py
COPY infrastructure/sql/007_shopify_variant_price_state.sql /opt/app/sql/
RUN pip install --no-cache-dir 'psycopg[binary]>=3.2,<4' \
    && useradd --system --uid 10001 ecommerce
USER ecommerce
ENTRYPOINT ["python", "/opt/app/apply_phase5_price_migration.py"]
